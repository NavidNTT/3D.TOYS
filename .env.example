###############################################################
#  Toy Store — Docker environment file
#
#  Usage:
#      cp .env.example .env.docker
#      docker compose --env-file .env.docker up -d --build
#
#  Docker Compose only auto-loads a file literally named `.env`, so the
#  `--env-file .env.docker` flag is passed explicitly throughout README.md.
#  Every value here also has a fallback default inside docker-compose.yml,
#  so a bare `docker compose up` still boots with these same dev values.
#
#  Consumed for BOTH variable interpolation (${VAR}) and container
#  environment. Laravel's own backend/.env is generated inside the container
#  by docker/php/bootstrap-laravel.sh from these same values.
#
#  Do NOT commit .env.docker — passwords live here.
#
#  Before the first boot, check nothing else owns these host ports:
#      netstat -ano | findstr ":8090 :3307 :6380 :9000 :9001"      (Windows)
#      lsof -iTCP:8090,3307,6380,9000,9001 -sTCP:LISTEN            (macOS/Linux)
###############################################################

# ── Project ───────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=toy-store
APP_NAME="Toy Store"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8090
LOG_LEVEL=debug

# ── Host port map (left side of "host:container") ─────────────
# Non-default host ports on purpose: developer machines very often already
# run MySQL on 3306, Redis on 6379 and *something* on 8080, and a silent
# clash costs more time than an unusual port number ever will.
NGINX_PORT=8090
FRONTEND_PORT=3000
MYSQL_PORT=3307
REDIS_PORT=6380
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# PHP-FPM exposed directly for Xdebug / IDE integrations. Must NOT collide
# with MINIO_API_PORT — that is why this is 9090 and not 9000.
PHP_FPM_PORT=9090

# ── MySQL 8.0 ─────────────────────────────────────────────────
MYSQL_DATABASE=toy_store_db
MYSQL_USER=toy_store
MYSQL_PASSWORD=toy_store_secret
MYSQL_ROOT_PASSWORD=root_secret

# ── Redis 7 (cache / sessions / queues) ───────────────────────
REDIS_PASSWORD=redis_secret

# ── MinIO (S3 compatible storage for 3D assets) ───────────────
MINIO_ROOT_USER=toy_admin
MINIO_ROOT_PASSWORD=toy_admin_secret
MINIO_BUCKET=toy-store-assets
# Anonymous read so <model-viewer> / next/image can stream .glb files.
# Switch to `none` once you serve signed URLs instead.
MINIO_BUCKET_POLICY=download

# ── How the apps address each other ───────────────────────────
# Browser-facing (runs on the host → localhost + published port)
NEXT_PUBLIC_API_URL=http://localhost:8090/api
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_MINIO_CONSOLE_URL=http://localhost:9001
MINIO_PUBLIC_URL=http://localhost:9000
# Container-to-container (Next.js server components, queue workers) uses
# service names on the internal network and container ports.
LARAVEL_INTERNAL_URL=http://nginx
MINIO_INTERNAL_URL=http://minio:9000
FRONTEND_INTERNAL_URL=http://nextjs.app:3000
# Sanctum: let the SPA on :3000 authenticate with cookies
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8090

# ── Laravel scaffolding ───────────────────────────────────────
# 12.x, not 11.x: Laravel 11 is end-of-life and every 11.x release now
# carries unpatched security advisories, which Composer 2.10 refuses to
# install by default (policy.advisories.block). Set ^11.0 here only if you
# also disable that policy deliberately.
LARAVEL_VERSION=^12.0

# ── Draco 3D optimization (gltf-transform) ──────────────────────
GLTF_TRANSFORM_PATH=gltf-transform
MODEL_3D_OPTIMIZED_DIR=models/3d/optimized
MODEL_3D_OPTIMIZE_TIMEOUT=120

# ── Queue worker ──────────────────────────────────────────────
QUEUE_CONNECTION=redis
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_TIMEOUT=120
# false = skip the entrypoint's composer install / APP_KEY step
RUN_SETUP=true

# ── Image tags ────────────────────────────────────────────────
PHP_IMAGE_TAG=8.3-fpm-alpine
# Debian (glibc), NOT alpine. Next.js loads a native SWC/Turbopack binary and
# its musl build can die with `Bus error (core dumped)` on Alpine — the dev
# server then exits silently with code 0 right after "✓ Starting..." and never
# reaches "✓ Ready". Verified working on this stack with the Debian image.
NODE_IMAGE_TAG=22-bookworm-slim
MYSQL_IMAGE_TAG=8.0
REDIS_IMAGE_TAG=7-alpine
NGINX_IMAGE_TAG=1.27-alpine

# MinIO: Docker Hub deleted the `minio/minio` and `minio/mc` repositories on
# 2026-09-11 and the GitHub repo is archived, so quay.io is the remaining
# official registry (verified reachable, and it bundles `mc`, which the
# healthcheck needs). Swapping object storage is a one-line change here —
# see README.md → "Object storage: the MinIO situation".
MINIO_IMAGE=quay.io/minio/minio
MINIO_IMAGE_TAG=latest
MINIO_MC_IMAGE=quay.io/minio/mc
MINIO_MC_TAG=latest

# ── Linux/macOS only: match your host user so bind mounts aren't root-owned
# Check with `id -u` / `id -g`, then uncomment and rebuild.
# APP_UID=1000
# APP_GID=1000
