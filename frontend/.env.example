# Frontend environment
#
# docker-compose already injects these into the nextjs.app container, so this
# file is only needed when running `npm run dev` straight on the host.
# Copy to .env.local and adjust.

# Called from the browser -> the host's published nginx port
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# MinIO public endpoint for model/thumbnail URLs
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_MINIO_CONSOLE_URL=http://localhost:9001

# Called from server components / route handlers. On the host there is no
# compose network, so fall back to the published port.
LARAVEL_INTERNAL_URL=http://localhost:8000
