APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Canonical product/media storage is MinIO over the S3 protocol (config/media.php).
# Compose supplies the real values; these placeholders match the Docker service names.
FILESYSTEM_DISK=s3
MEDIA_CANONICAL_DISK=s3
# Uploads go straight to object storage too: the Draco optimizer streams the
# model through a private temp directory, so no local `->path()` is needed.
# Point this at the canonical MinIO disk name (`s3`) — see config/media.php.
MEDIA_INGEST_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=toy-store-assets
# Internal address (the Docker service name) used by the containers…
AWS_ENDPOINT=http://minio:9000
# …and the host-published address that generated URLs hand to the browser.
AWS_URL=http://localhost:9000/toy-store-assets
# Required for a single MinIO endpoint.
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Draco 3D optimization (gltf-transform) ──────────────────────
# Global install: "gltf-transform" | local npm install: "npx @gltf-transform/cli"
GLTF_TRANSFORM_PATH=gltf-transform
MODEL_3D_OPTIMIZED_DIR=models/3d/optimized
MODEL_3D_OPTIMIZE_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
